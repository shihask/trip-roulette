# Copy to .env.local for local development. Never commit real values.

# Public site URL (used for metadata and share links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (public values only — publishable key sb_publishable_…; the secret key lives in Edge Function secrets, never here)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Cloudflare Turnstile site key (public). Turns on the security check at guest and admin sign-in.
# Set it here and in Vercel BEFORE enabling CAPTCHA in Supabase (Authentication → Attack Protection).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Secret for /api/revalidate (called by the admin after publish/archive)
REVALIDATE_SECRET=

# Public contact address shown on /contact and /privacy (leave empty until there is one)
NEXT_PUBLIC_CONTACT_EMAIL=

# Optional: admin account for the signed-in admin end-to-end test (tests/e2e/admin.e2e.ts). Local only; never commit.
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
